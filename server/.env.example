# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://resonant:resonant@localhost:5432/resonant?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
